generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de prueba
model Producto {
  id     Int    @id @default(autoincrement())
  nombre String
  precio Float
}
model Produccion {
  id          String   @id @default(cuid())
  lote        String   @unique
  fecha       DateTime
  paddy       Float
  blanco      Float
  rendimiento Float
  etapa       String?
  estado      String   @default("En proceso") // "En proceso" | "Completado"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}