generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RegistroRendimiento {
  id          Int      @id @default(autoincrement())
  variedad    String   // Ejemplo: tipo de arroz
  rendimiento Float    // Rendimiento en toneladas
  loteSilo    String
  fecha       DateTime @default(now())
}